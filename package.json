{
  "name": "clickup-espelho",
  "version": "0.13.2",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --external:obsidian --format=cjs --target=es2020 --outfile=main.js",
    "test": "esbuild test/run.ts --bundle --platform=node --format=esm --outfile=test/run.mjs && node test/run.mjs",
    "install-plugin": "node install.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2"
  }
}
